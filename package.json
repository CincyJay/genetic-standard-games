{
  "name": "genetic-standard-games",
  "private": true,
  "version": "0.1.0",
  "description": "Mobile puzzle games by The Genetic Standard LLC",
  "type": "module",
  "workspaces": [
    "packages/*",
    "games/*"
  ],
  "scripts": {
    "dev": "npm run dev -w games/seed-sort",
    "build": "npm run build -w games/seed-sort",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p games/seed-sort",
    "levels": "npm run levels -w games/seed-sort",
    "playtest": "node games/seed-sort/tests/e2e/playtest.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "phaser": "^4.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
