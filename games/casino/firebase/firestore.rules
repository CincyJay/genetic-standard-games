rules_version = '2';
// Velvet Ace: only signed-in players; you can only change your own data.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }

    // public profile: anyone signed in can read; only the owner writes it
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if isMe(uid)
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 20;
      allow delete: if isMe(uid);

      // friends and blocks are private lists kept by their owner
      match /friends/{other} { allow read, write: if isMe(uid); }
      match /blocked/{other} { allow read, write: if isMe(uid); }
    }

    // usernames are unique: a claim document per lower-case name, owned by one player
    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && name.size() >= 3 && name.size() <= 20;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // friend requests: the sender creates; the receiver accepts (status) or either side deletes
    match /friendRequests/{id} {
      allow create: if signedIn() && request.resource.data.from == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read, delete: if signedIn() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow update: if signedIn() && resource.data.to == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'accepted';
    }

    // chat rooms (lobby, tables, lounge): post as yourself, short messages, never edited
    match /rooms/{room}/messages/{msg} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 200
        && request.resource.data.at == request.time;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // direct messages: only the two people in the conversation
    match /dms/{pair}/messages/{msg} {
      function inPair() { return signedIn() && request.auth.uid in pair.split('_'); }
      allow read: if inPair();
      allow create: if inPair() && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() <= 500;
      allow update, delete: if false;
    }

    // reports for moderation: players file them, only the moderators (console) read them
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.by == request.auth.uid;
      allow read, update, delete: if false;
    }
  }
}
